# Kopieren nach .env und ausfüllen. .env gehört nicht ins Repository.
DB_KENNWORT=
# ICE-Server für WebRTC als JSON (STUN/TURN). Leer: nur direkte Verbindungen,
# reicht im eigenen Netz. Für Teilnehmer von außen braucht es einen TURN-Server.
# MEETR_ICE=[{"urls":"turn:turn.example.org:3478","username":"u","credential":"k"}]
# Notausgang, falls man sich ausgesperrt hat:
# MEETR_SSO_AUS=1
